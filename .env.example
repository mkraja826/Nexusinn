# Public production URL used for canonical URLs, sitemap and same-origin contact validation.
NEXT_PUBLIC_SITE_URL=https://example.com

# Resend server-side API key. Configure this only in the deployment environment.
RESEND_API_KEY=

# Verified sender identity/domain in Resend.
RESEND_FROM_EMAIL=Nexusinn Website <enquiries@nexusinn.com.au>

# Website enquiries are delivered here.
ENQUIRY_TO_EMAIL=hr@nexusinn.com.au
